# Gemini API Key - configurar en Netlify > Site configuration > Environment variables
GEMINI_API_KEY=

# Base de datos Neon (provisto por Netlify DB add-on)
NETLIFY_DATABASE_URL=

# JWT Secret - cadena aleatoria larga para firmar tokens de sesión
JWT_SECRET=

# Google OAuth Client ID (opcional - habilita login con Google)
# Obtener en: console.cloud.google.com > APIs & Services > Credentials
# También agregar como GOOGLE_CLIENT_ID para validación server-side
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
